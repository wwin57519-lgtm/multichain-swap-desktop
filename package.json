{
  "name": "base-swap-desktop",
  "version": "0.7.5",
  "private": true,
  "description": "Local Ethereum, BSC and Base swap executor",
  "author": "Local Tools",
  "main": "src/main.cjs",
  "dependencies": {
    "ethers": "6.17.0"
  },
  "productName": "Base Swap Desktop",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "build:contracts": "node scripts/build-contracts.cjs",
    "test": "node --test test/*.test.cjs",
    "smoke": "electron . --verify-startup"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.18.0",
    "solc": "0.8.36"
  },
  "build": {
    "artifactName": "MultiChain-Swap-Desktop-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "artifacts/**/*",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "appId": "local.base.uniswap.executor"
  },
  "license": "MIT"
}
